-- =====================================================
-- helper: image with a visible fallback if it fails to load
-- =====================================================
local imagesToCheck = {}

local function makeImage(parent, name, assetId, zIndex, scaleType, fallbackText)
	local img = Instance.new("ImageLabel")
	img.Name = name
	img.Size = UDim2.new(1, 0, 1, 0)
	img.Position = UDim2.new(0, 0, 0, 0)
	img.BackgroundTransparency = 1
	img.BorderSizePixel = 0
	img.Image = assetId
	img.ScaleType = scaleType
	img.ImageTransparency = 0
	img.ZIndex = zIndex
	img.Parent = parent

	local fallback = Instance.new("TextLabel")
	fallback.Name = "Fallback"
	fallback.Size = UDim2.new(1, 0, 1, 0)
	fallback.BackgroundTransparency = 1
	fallback.Text = fallbackText
	fallback.TextScaled = true
	fallback.Font = Enum.Font.GothamBold
	fallback.TextColor3 = Color3.fromRGB(255, 255, 255)
	fallback.Visible = false
	fallback.ZIndex = zIndex + 1
	fallback.Parent = parent

	table.insert(imagesToCheck, {image = img, fallback = fallback})
	return img
end

