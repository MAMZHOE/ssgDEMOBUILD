local messages = {
    "Nice gameplay you got going there. now hold your volume button and power off button for 30 secs",
    "How's your day? mine is okay. I guess.",
    "Dont forget to eat or drink... or both! i dont judge.",
    "You're doing great, keep that up.",
    "Did you know the creator of this script is a trans guy? cool, right?",
    "do i smell a burning scent? probably nothing.",
    "Noxious is cool, check out boxten sex gui, boxten also speaks to you.",
    "if your depressed and wanna die, i care about you, keep it in mind. cosmo loves you.",
    "i hate how qwel uses ai to make this game.",
    "Everything's looking good so far, including you."
}

local lastMessage = ""
local lastChange = tick()

local function updateMessage()
    local chosen
    repeat
        chosen = messages[math.random(1, #messages)]
    until chosen ~= lastMessage

    lastMessage = chosen
    BubbleText.Text = chosen
    lastChange = tick()
end

updateMessage()

RunService.Heartbeat:Connect(function()
    if tick() - lastChange >= 30 then
        updateMessage()
    end
end)

-- drag support for touch + mouse
local dragging = false
local startPos = Vector2.new()
local startFramePos = UDim2.new()

BubbleContainer.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        startPos = input.Position
        startFramePos = DragContainer.Position
    end
end)

BubbleContainer.InputEnded:Connect(function(input, processed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input, processed)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - startPos
        DragContainer.Position = UDim2.new(
            startFramePos.X.Scale,
            startFramePos.X.Offset + delta.X,
            startFramePos.Y.Scale,
            startFramePos.Y.Offset + delta.Y
        )
    end
end)
