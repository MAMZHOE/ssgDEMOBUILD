-- ===== MESSAGE ROTATION =====
local messageIndex = 1

local function updateMessage()
    BubbleText.Text = messages[messageIndex]
    messageIndex = messageIndex + 1
    if messageIndex > #messages then
        messageIndex = 1
    end
end

-- change message every 30 seconds
game:GetService("RunService").Heartbeat:Connect(function()
    -- update every 30 seconds (1800 frames at 60fps)
    if tick() % 30 < 0.1 then
        updateMessage()
    end
end)

-- alternative timer approach (more reliable)
local lastUpdate = tick()
game:GetService("RunService").Heartbeat:Connect(function()
    if tick() - lastUpdate >= 30 then
        updateMessage()
        lastUpdate = tick()
    end
end)
