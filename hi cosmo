	"Noxious is cool, check out boxten sex gui, boxten also speaks to you.",
	"if your depressed and wanna die, i care about you, keep it in mind. cosmo loves you.",
	"You are doing amazing today.",
	"Everything's looking good so far."
}

local lastMessage = ""
local lastChange = tick()

local function updateMessage()
	local chosen
	repeat
		chosen = messages[math.random(1, #messages)]
	until chosen ~= lastMessage

	lastMessage = chosen
	BubbleText.Text = chosen
	lastChange = tick()
end

updateMessage()

RunService.Heartbeat:Connect(function()
	if tick() - lastChange >= 30 then
		updateMessage()
	end
end)

-- =====================================================
-- drag support (mouse + touch) from the bubble OR the mascot
-- =====================================================
local dragging = false
local startPos = Vector2.new()
local startFramePos = UDim2.new()

local function beginDrag(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		startPos = input.Position
		startFramePos = DragContainer.Position
	end
end

local function endDrag(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end

BubbleContainer.InputBegan:Connect(beginDrag)
BubbleContainer.InputEnded:Connect(endDrag)
MascotContainer.InputBegan:Connect(beginDrag)
MascotContainer.InputEnded:Connect(endDrag)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - startPos
		DragContainer.Position = UDim2.new(
			startFramePos.X.Scale,
			startFramePos.X.Offset + delta.X,
			startFramePos.Y.Scale,
			startFramePos.Y.Offset + delta.Y
		)
	end
end)
