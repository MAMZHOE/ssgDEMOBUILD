-- ===== MESSAGE ROTATION (RANDOMIZED, NO REPEATS) =====
local lastMessage = ""
local lastMessageTime = tick()

local function updateMessage()
    local randomIndex
    repeat
        randomIndex = math.random(1, #messages)
    until messages[randomIndex] ~= lastMessage
    
    lastMessage = messages[randomIndex]
    BubbleText.Text = lastMessage
    lastMessageTime = tick()
end

-- change message every 30 seconds
game:GetService("RunService").Heartbeat:Connect(function()
    if tick() - lastMessageTime >= 30 then
        updateMessage()
    end
end)

-- ===== DRAGGABLE FUNCTIONALITY (MOBILE + DESKTOP) =====
local UserInputService = game:GetService("UserInputService")
local mouse = LocalPlayer:GetMouse()

local isDragging = false
local dragStart = Vector2.new(0, 0)
local containerStart = UDim2.new(0, 0, 0, 0)

-- Mouse button drag (Desktop)
BubbleContainer.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = true
        dragStart = Vector2.new(mouse.X, mouse.Y)
        containerStart = DragContainer.Position
    end
end)

BubbleContainer.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = false
    end
end)

-- Touch drag (Mobile)
BubbleContainer.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        dragStart = Vector2.new(input.Position.X, input.Position.Y)
        containerStart = DragContainer.Position
    end
end)

BubbleContainer.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
    end
end)

-- Input changed for both mouse and touch
UserInputService.InputChanged:Connect(function(input, gameProcessed)
    if isDragging then
        local currentPos = Vector2.new(0, 0)
        
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            currentPos = Vector2.new(mouse.X, mouse.Y)
        elseif input.UserInputType == Enum.UserInputType.Touch then
            currentPos = Vector2.new(input.Position.X, input.Position.Y)
        end
        
        if currentPos ~= Vector2.new(0, 0) then
            local delta = currentPos - dragStart
            DragContainer.Position = UDim2.new(
                containerStart.X.Scale,
                containerStart.X.Offset + delta.X,
                containerStart.Y.Scale,
                containerStart.Y.Offset + delta.Y
            )
        end
    end
end)
