-- =====================================================
-- load check: shows a fallback + warns if an image fails
-- =====================================================
task.spawn(function()
	local list = {}
	for _, entry in ipairs(imagesToCheck) do
		table.insert(list, entry.image)
	end

	pcall(function()
		ContentProvider:PreloadAsync(list)
	end)

	for _, entry in ipairs(imagesToCheck) do
		if not entry.image.IsLoaded then
			warn(("[CompanyUI] %s failed to load (%s). Make sure this is an IMAGE id, not a Decal id."):format(entry.image.Name, entry.image.Image))
			entry.image.Visible = false
			entry.fallback.Visible = true
		end
	end
end)

